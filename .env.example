# Neon/Vercel managed variables: pooled runtime and direct migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
FIELD_ENCRYPTION_KEY_CURRENT=""
FIELD_ENCRYPTION_KEY_PREVIOUS=""

# The account is bootstrapped/updated on its first successful login.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Vercel Blob private store
BLOB_READ_WRITE_TOKEN=""

# Restricted AI orchestration. NEXO uses Gemini 3.1 Flash-Lite in production.
AI_PRIMARY_PROVIDER="gemini"
AI_PRIMARY_API_KEY=""
AI_PRIMARY_MODEL="gemini-3.1-flash-lite"
AI_FALLBACK_PROVIDER="deterministic"
AI_FALLBACK_API_KEY=""

# Gemini 3.1 Flash-Lite accepts audio input for transcription.
STT_PROVIDER="gemini"
# Optional: when empty, transcription reuses AI_PRIMARY_API_KEY.
STT_API_KEY=""
TTS_PROVIDER="browser"
TTS_API_KEY=""

APP_BASE_URL="http://localhost:3000"
PROTOCOL_VERSION="2.0"
PRIVACY_NOTICE_VERSION="1.0"
EMERGENCY_CONTACTS_VERSION="2026-09-02"
OBSERVABILITY_DSN=""
RATE_LIMIT_STORE="database"
WORKFLOW_SECRET=""
CRON_SECRET=""
