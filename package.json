{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && npm run db:seed && npm run build:app",
    "build:app": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "protocol:verify": "node scripts/verify-protocol.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check": "npm run protocol:verify && npm run lint && npm run typecheck && npm run test && npm run build:app"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "4.1.11"
  },
  "overrides": { "deepmerge-ts": "8.0.2" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
